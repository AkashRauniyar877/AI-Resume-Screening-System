# ==============================================================================
# AI Resume Screening System - Environment Configuration Template
# Copy this file to .env or backend/.env and update values accordingly.
# NEVER commit real secret keys, JWT secrets, or production passwords to git!
# ==============================================================================

# Database Configuration (Required)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_resume_screening_db

# Application Configuration (Optional)
ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & JWT Configuration (Required)
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_long_random_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000

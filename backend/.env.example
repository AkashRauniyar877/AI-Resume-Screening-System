# Backend Environment Configuration Template
# Copy this file to backend/.env and replace placeholders.

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_resume_screening_db

# Application Configuration
ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & JWT Configuration
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
